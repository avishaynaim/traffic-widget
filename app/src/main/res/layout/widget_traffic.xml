<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/widget_background">

    <!-- Header row: direction toggle + refresh + settings -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/directionButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="→🏠 To Home"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:gravity="center_vertical"
            android:background="#33FFFFFF"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/refreshButton"
            android:layout_width="36dp"
            android:layout_height="match_parent"
            android:text="🔄"
            android:textSize="16sp"
            android:gravity="center"
            android:background="#33FFFFFF"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/settingsButton"
            android:layout_width="36dp"
            android:layout_height="match_parent"
            android:text="⚙️"
            android:textSize="16sp"
            android:gravity="center"
            android:background="#33FFFFFF" />

    </LinearLayout>

    <!-- Main area: gauge image + info -->
    <LinearLayout
        android:id="@+id/gaugeContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp">

        <!-- Canvas-drawn semicircle gauge bitmap -->
        <ImageView
            android:id="@+id/gaugeImage"
            android:layout_width="110dp"
            android:layout_height="68dp"
            android:scaleType="fitCenter" />

        <!-- Info column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="4dp">

            <TextView
                android:id="@+id/statusLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Unknown"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/travelTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-- min"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/delayInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tap to configure"
                android:textSize="11sp"
                android:textColor="#B0FFFFFF"
                android:maxLines="2"
                android:ellipsize="end" />

        </LinearLayout>

    </LinearLayout>

    <!-- Footer: last update time -->
    <TextView
        android:id="@+id/lastUpdate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Not updated"
        android:textSize="10sp"
        android:textColor="#80FFFFFF"
        android:gravity="center" />

</LinearLayout>
